generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConsultationMode {
  ONLINE
  OFFLINE
  BOTH
}

enum HospitalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  HOLD
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum LabBookingStatus {
  PENDING
  SAMPLE_COLLECTED
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  PENDING
  READY
}

enum GenderPreference {
  MALE
  FEMALE
  ALL
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum ReminderType {
  MEDICINE
  APPOINTMENT
  TEST
  CUSTOM
}

enum ReminderRepeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum ReminderStatus {
  ACTIVE
  COMPLETED
  SKIPPED
  EXPIRED
}

model User {
  id       Int        @id @default(autoincrement())
  phone    String?    @unique
  email    String?    @unique
  password String?
  status   UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings         Booking[]
  labBookings      LabBooking[]
  labCart          LabCart[]
  patientProfiles  PatientProfile[]
  reminders        Reminder[]
  notifications    Notification[]
  labPrescriptions LabPrescription[]
}

model Hospital {
  id        Int     @id @default(autoincrement())
  name      String
  city      String?
  state     String?
  latitude  Float?
  longitude Float?
  rating    Float?  @default(0)
  isOpen    Boolean @default(true)

  consultationMode ConsultationMode @default(BOTH)
  status           HospitalStatus   @default(PENDING)

  categories    Category[]
  doctors       Doctor[]
  notifications Notification[]

  createdAt DateTime @default(now())
}

model Category {
  id         Int    @id @default(autoincrement())
  name       String
  hospitalId Int

  hospital Hospital  @relation(fields: [hospitalId], references: [id])
  doctors  Doctor[]
  symptoms Symptom[]
}

model Symptom {
  id   Int    @id @default(autoincrement())
  name String

  doctors    DoctorSymptom[]
  Category   Category?       @relation(fields: [categoryId], references: [id])
  categoryId Int?
}

model DoctorSymptom {
  doctorId  Int
  symptomId Int

  Doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  Symptom Symptom @relation(fields: [symptomId], references: [id], onDelete: Cascade)

  @@id([doctorId, symptomId])
}

model Doctor {
  id         Int    @id @default(autoincrement())
  name       String
  experience Int
  hospitalId Int
  categoryId Int

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  availabilities DoctorAvailability[]
  timeSlots      TimeSlot[]
  bookings       Booking[]

  createdAt     DateTime        @default(now())
  DoctorSymptom DoctorSymptom[]
}

model DoctorAvailability {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  date      DateTime
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@index([doctorId, date])
}

model TimeSlot {
  id       Int      @id @default(autoincrement())
  doctorId Int
  start    DateTime
  end      DateTime
  isActive Boolean  @default(true)

  doctor  Doctor   @relation(fields: [doctorId], references: [id])
  booking Booking?

  @@unique([doctorId, start, end])
}

model Booking {
  id         Int @id @default(autoincrement())
  userId     Int
  doctorId   Int
  timeSlotId Int @unique

  start     DateTime
  end       DateTime
  status    BookingStatus
  expiresAt DateTime?

  user     User     @relation(fields: [userId], references: [id])
  doctor   Doctor   @relation(fields: [doctorId], references: [id])
  timeSlot TimeSlot @relation(fields: [timeSlotId], references: [id])

  notification Notification?
  createdAt    DateTime      @default(now())
}

model Notification {
  id         Int  @id @default(autoincrement())
  bookingId  Int  @unique
  hospitalId Int
  userId     Int?

  message String
  read    Boolean @default(false)

  booking  Booking  @relation(fields: [bookingId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model PatientProfile {
  id       Int     @id @default(autoincrement())
  userId   Int
  fullName String
  age      Int?
  gender   String?

  user User @relation(fields: [userId], references: [id])
}

model Lab {
  id        Int     @id @default(autoincrement())
  name      String
  city      String?
  latitude  Float?
  longitude Float?
  rating    Float?
  isOpen    Boolean @default(true)

  categories LabCategory[] @relation("LabCategories")
  tests      LabTest[]
  bookings   LabBooking[]

  createdAt DateTime  @default(now())
  LabCart   LabCart[]
}

model LabCategory {
  id   Int    @id @default(autoincrement())
  name String
  type String

  labs  Lab[]     @relation("LabCategories")
  tests LabTest[]
}

model LabTest {
  id          Int     @id @default(autoincrement())
  name        String
  price       Int
  reportTime  String?
  isAvailable Boolean @default(true)

  labId      Int
  categoryId Int
 minAge Int?
  maxAge Int?
  lab      Lab         @relation(fields: [labId], references: [id])
  category LabCategory @relation(fields: [categoryId], references: [id])

  bookings LabBooking[]
  LabCart  LabCart[]
}

model LabBooking {
  id        Int @id @default(autoincrement())
  userId    Int
  labId     Int
  labTestId Int

  sampleDate DateTime
  status     LabBookingStatus @default(PENDING)

  user User    @relation(fields: [userId], references: [id])
  lab  Lab     @relation(fields: [labId], references: [id])
  test LabTest @relation(fields: [labTestId], references: [id])

  report   LabReport?
  feedback LabFeedback?

  createdAt DateTime @default(now())
}

model LabReport {
  id           Int          @id @default(autoincrement())
  bookingId    Int          @unique
  reportStatus ReportStatus
  reportUrls   Json

  booking   LabBooking @relation(fields: [bookingId], references: [id])
  createdAt DateTime   @default(now())   // ✅ ADD THIS
}


model LabFeedback {
  id        Int     @id @default(autoincrement())
  bookingId Int     @unique
  rating    Int
  comment   String?

  booking LabBooking @relation(fields: [bookingId], references: [id])
}

model LabCart {
  id        Int @id @default(autoincrement())
  userId    Int
  labId     Int
  labTestId Int
  quantity  Int @default(1)

  user User    @relation(fields: [userId], references: [id])
  lab  Lab     @relation(fields: [labId], references: [id])
  test LabTest @relation(fields: [labTestId], references: [id])

  @@unique([userId, labTestId])
}

model LabPrescription {
  id       Int    @id @default(autoincrement())
  userId   Int
  fileUrl  String
  fileType String
  status   String @default("UPLOADED")

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Reminder {
  id         Int            @id @default(autoincrement())
  userId     Int
  type       ReminderType
  title      String
  reminderAt DateTime
  repeat     ReminderRepeat @default(NONE)
  status     ReminderStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
